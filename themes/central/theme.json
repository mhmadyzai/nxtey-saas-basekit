{
    "$schema": "https://raw.githubusercontent.com/alizharb/laravel-themer/main/resources/schemas/theme.schema.json",
    "name": "central",
    "slug": "central",
    "description": "Central theme for Nxt Net SaaS",
    "version": "1.0.0",
    "author": "Nxtey @ Deep",
    "pwa": {
        "name": "NxtSaaSNet Admin",
        "short_name": "NxtSaaS",
        "description": "Central administration for NxtSaaSNet",
        "theme_color": "#4f46e5",
        "background_color": "#ffffff",
        "display": "standalone",
        "orientation": "portrait",
        "start_url": "/blog",
        "scope": "/",
        "icons": [
            { "src": "/themes/central/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" },
            { "src": "/themes/central/pwa/icon-512.png", "sizes": "512x512", "type": "image/png" },
            { "src": "/themes/central/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
        ]
    },
    "tags": [
        "modern",
        "responsive"
    ],
    "asset_path": "themes/central",
    "parent": null,
    "screenshots": [
    {
        "src": "/themes/central/resources/assets/screenshots/screenshot-light.png",
        "sizes": "1280x720",
        "type": "image/png",
        "form_factor": "wide",
        "label": "Central on desktop"
    },
    {
        "src": "/themes/central/resources/assets/screenshots/screenshot-light.png",
        "sizes": "720x1280",
        "type": "image/png",
        "form_factor": "narrow",
        "label": "Central on mobile"
    }
],
    "removable": true,
    "disableable": true,
    "requires": {
        "themes": [],
        "modules": [],
        "packages": {}
    },
    "conflicts": [],
    "provides": [],
    "tokens": {
        "color.primary": "#2563eb",
        "color.background": "#ffffff",
        "radius.card": "1rem"
    },
    "hooks": {}
}